# ── SocialLens API Keys ───────────────────────────────────────────────────────
# Copy this file to .env and fill in your keys.

# Anthropic Claude API (required for VLM social analysis and voice profiling)
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=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

# ElevenLabs TTS API (optional — voice generation will be disabled without this)
# Get yours at: https://elevenlabs.io/
ELEVENLABS_API_KEY=sk_9a95dad28d9e283c24a1c71aea786172543e83b5a51e1587

# ── CV Detector Settings (YOLO + YOLO-Pose) ─────────────────────────────────
# Person detector weights (downloaded automatically by ultralytics on first run)
YOLO_MODEL=yolov8n.pt
YOLO_CONF=0.25
YOLO_IOU=0.45
YOLO_MAX_PERSONS=20

# Pose model used for body orientation + attention direction estimation
YOLO_POSE_MODEL=yolov8n-pose.pt
YOLO_POSE_CONF=0.25

# Optional: head/gaze model adapter
# 1 = enable adapter (tries 6DRepNet/Gaze-LLE if installed), 0 = geometry only
ENABLE_HEAD_GAZE_MODEL=1
